# /etc/systemd/system/prefect-worker-pdd-desa.service

[Unit]
Description=Prefect Worker PDD Publicador DESA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pdd
Group=pdd
WorkingDirectory=/srv/PDD/backend

Environment="HOME=/var/lib/pdd"
Environment="PATH=/srv/PDD/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/srv/PDD/backend"
Environment="PREFECT_API_URL=https://orquestador.connexa-cloud.com/api"
Environment="PDD_ENV_PATH=/etc/connexa/pdd-desa.env"
Environment="PDD_OPERATIONAL_TARGET_ENV=DESA"

ExecStart=/srv/PDD/.venv/bin/prefect worker start --name "pdd-diarco-desa" --pool "diarco-pdd" --work-queue "pdd-desa" --limit 1

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
