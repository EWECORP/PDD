# Puede reutilizar las variables PG_* de FORECAST apuntando a diarco_data.
PG_HOST=postgres-host
PG_PORT=5432
PG_DB=diarco_data
PG_USER=usuario
PG_PASSWORD=secreto

# Identidades logicas. Deben coincidir posteriormente con
# connexa_platform_ms.stock_management.
PDD_SCOPE_VERSION_UUID=
PDD_MODEL_VERSION_UUID=

# Opcionales.
PDD_DB_STATEMENT_TIMEOUT_MS=1800000
PDD_DB_LOCK_TIMEOUT_MS=30000
PDD_DB_KEEPALIVES_IDLE_SECONDS=60
PDD_DB_KEEPALIVES_INTERVAL_SECONDS=30
PDD_DB_KEEPALIVES_COUNT=5

# Destino operativo. Por seguridad solo connexa_platform_test esta habilitada.
PDD_OPERATIONAL_PG_HOST=186.158.182.223
PDD_OPERATIONAL_PG_PORT=5432
PDD_OPERATIONAL_PG_DB=connexa_platform_test
PDD_OPERATIONAL_PG_USER=
PDD_OPERATIONAL_PG_PASSWORD=
PDD_OPERATIONAL_DB_STATEMENT_TIMEOUT_MS=1800000
PDD_OPERATIONAL_DB_LOCK_TIMEOUT_MS=30000
PDD_OPERATIONAL_DB_KEEPALIVES_IDLE_SECONDS=60
PDD_OPERATIONAL_DB_KEEPALIVES_INTERVAL_SECONDS=30
PDD_OPERATIONAL_DB_KEEPALIVES_COUNT=5
# No habilitar en Test. Produccion requiere una decision operativa explicita.
PDD_OPERATIONAL_ALLOW_PRODUCTION=false
PDD_ORIGIN_CD=41

# API HTTP PDD. El modo proxy es fail-closed: el gateway corporativo valida el
# JWT y agrega identidad/roles junto con un secreto compartido.
PDD_API_ENVIRONMENT=TEST
PDD_API_HOST=127.0.0.1
PDD_API_PORT=8088
PDD_API_WORKERS=2
PDD_API_DB_STATEMENT_TIMEOUT_MS=15000
PDD_API_DB_LOCK_TIMEOUT_MS=3000
PDD_API_AUTH_MODE=proxy
PDD_API_PROXY_SECRET=
PDD_API_CURSOR_SECRET=
PDD_API_FORWARDED_ALLOW_IPS=127.0.0.1
# Origenes separados por coma; vacio deshabilita CORS en la aplicacion.
PDD_API_CORS_ORIGINS=
# Solo para pruebas locales deliberadas; nunca habilitar en Produccion.
PDD_API_ALLOW_TEST_AUTH=false
