# Conexion analitica a diarco_data.
PG_HOST=postgres-analitico
PG_PORT=5432
PG_DB=diarco_data
PG_USER=pdd_runtime_user
PG_PASSWORD=REEMPLAZAR_EN_SERVIDOR

# Seleccion funcional versionada en audit.pdd_runtime_binding.
PDD_RUNTIME_ENVIRONMENT=PROD
PDD_RUNTIME_PROCESS_CODE=DAILY_MASTER

PDD_ORIGIN_CD=41
PDD_DB_STATEMENT_TIMEOUT_MS=1800000
PDD_DB_LOCK_TIMEOUT_MS=30000
PDD_DB_KEEPALIVES_IDLE_SECONDS=60
PDD_DB_KEEPALIVES_INTERVAL_SECONDS=30
PDD_DB_KEEPALIVES_COUNT=5

# Destino operativo productivo.
PDD_OPERATIONAL_TARGET_ENV=PROD
PDD_OPERATIONAL_PG_HOST=postgres-operativo
PDD_OPERATIONAL_PG_PORT=5432
PDD_OPERATIONAL_PG_DB=connexa_platform_ms
PDD_OPERATIONAL_PG_USER=pdd_operational_user
PDD_OPERATIONAL_PG_PASSWORD=REEMPLAZAR_EN_SERVIDOR
PDD_OPERATIONAL_SCHEMA=stock_management
PDD_OPERATIONAL_ALLOW_PRODUCTION=true

PDD_OPERATIONAL_DB_STATEMENT_TIMEOUT_MS=1800000
PDD_OPERATIONAL_DB_LOCK_TIMEOUT_MS=30000
PDD_OPERATIONAL_DB_KEEPALIVES_IDLE_SECONDS=60
PDD_OPERATIONAL_DB_KEEPALIVES_INTERVAL_SECONDS=30
PDD_OPERATIONAL_DB_KEEPALIVES_COUNT=5

# Fallback transitorio: retirar despues de activar y validar el binding PROD.
# PDD_SCOPE_VERSION_UUID=
# PDD_MODEL_VERSION_UUID=
